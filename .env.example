# ---------------------------------------------------------------------------
# Local development / tooling only.
#
# On Cloudflare Workers these values come from `wrangler secret put` and the
# `vars` block in wrangler.jsonc — NOT from this file. Bindings (Hyperdrive, KV,
# R2, Queues, AI) have no .env equivalent at all; see docs/PHASE_0.md for the
# provisioning commands.
# ---------------------------------------------------------------------------

# Postgres. In production this comes from the HYPERDRIVE binding; DATABASE_URL is
# the fallback used by drizzle-kit and the integration tests.
#
# For Supabase use the DIRECT CONNECTION string, not the Supavisor pooler one:
# Supavisor behind Hyperdrive means double pooling and loses prepared statements
# (docs/PRODUCT_PLAN.md §5.5).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/startup_jobs

# Base URL for Better Auth (OAuth callbacks are derived from it).
BETTER_AUTH_URL=http://localhost:3000
VITE_BETTER_AUTH_URL=http://localhost:3000

# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth — authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# LLM providers (docs/PRODUCT_PLAN.md §11: hybrid budget)
#
# Cheap, high-volume classification runs on the Workers AI binding, which has no
# key. These external keys serve the "accurate" tier — extracting salary bands,
# equity and tech stack from free text, where quality is visible to users.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional overrides
GEMINI_API_VERSION=v1
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.0-flash
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# ---------------------------------------------------------------------------
# Billing (Phase 4.5 — not wired into the product yet)
# ---------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_GROWTH_PRODUCT_ID=
POLAR_CHECKOUT_SLUG=growth
POLAR_SUCCESS_URL=http://localhost:3000/billing/success
POLAR_SERVER=sandbox
