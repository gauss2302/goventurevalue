# Database: Cloudflare D1 (configured in wrangler.jsonc, binding name DB)
# Local dev uses Miniflare D1 via @cloudflare/vite-plugin — run `pnpm db:migrate:local` first.

# Better Auth Configuration
# Local dev (`pnpm dev`): http://localhost:8787
# Production: https://havamind.com
# Production vars are set in wrangler.jsonc — override here only for local dev.
BETTER_AUTH_URL=http://localhost:8787
VITE_BETTER_AUTH_URL=http://localhost:8787

# Better Auth Secret (REQUIRED for production)
# Generate a secure random string: openssl rand -base64 32
# Set via `wrangler secret put BETTER_AUTH_SECRET` for production
# For local dev, copy .dev.vars.example to .dev.vars
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID with authorized redirect URIs:
#   - http://localhost:8787/api/auth/callback/google (local Wrangler dev)
#   - https://havamind.com/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Pitch Deck AI Providers
OPENAI_API_KEY=
OPENAI_PITCH_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_PITCH_MODEL=gemini-2.0-flash
GEMINI_API_VERSION=v1
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.0-flash

# Polar Billing (exports subscription)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SUCCESS_URL=http://localhost:8787/billing/success
POLAR_EXPORTS_PRODUCT_ID=
POLAR_CHECKOUT_SLUG=exports

# Unsplash API (optional — for Full AI pitch deck theme photo search)
UNSPLASH_ACCESS_KEY=

# Public site URL for SEO (canonical, Open Graph, sitemap). Defaults to production workers.dev URL.
# VITE_SITE_URL=https://havamind.com
